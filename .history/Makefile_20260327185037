# --- NAMES ---
NAME		= cub3D

# --- DIRECTORIES ---
SRC_DIR		= src
OBJ_DIR		= objects
INC_DIR		= includes
MLX_DIR		= mlx

# --- FILES ---
# Add new .c files here as you create them
SRC_FILES	= main.c

# These lines map the files to the correct folders
SRCS		= $(addprefix $(SRC_DIR)/, $(SRC_FILES))
OBJS		= $(addprefix $(OBJ_DIR)/, $(SRC_FILES:.c=.o))

# --- COMPILER & FLAGS ---
CC			= cc
CFLAGS		= -Wall -Wextra -Werror -g3 -I$(INC_DIR)

# MLX Flags for Linux/WSL
MLX_FLAGS	= -L$(MLX_DIR) -lmlx -framework Metal -framework AppKit

# --- RULES ---

all: $(NAME)

# Rule to compile the executable
$(NAME): $(OBJS)
	@echo "Compiling MiniLibX..."
	@make -C $(MLX_DIR)
	@echo "Linking $(NAME)..."
	@$(CC) $(CFLAGS) $(OBJS) $(MLX_FLAGS) -o $(NAME)
	@echo "Done! ./$(NAME) is ready."

# Rule to compile objects (src/*.c -> objects/*.o)
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(OBJ_DIR)
	@$(CC) $(CFLAGS) -c $< -o $@

# Cleanup rules
clean:
	@echo "Cleaning object files..."
	@rm -rf $(OBJ_DIR)
	@make clean -C $(MLX_DIR) > /dev/null 2>&1

fclean: clean
	@echo "Removing executable..."
	@rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re

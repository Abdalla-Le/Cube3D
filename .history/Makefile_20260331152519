# --- NAMES ---
NAME		= cub3D

# --- DIRECTORIES ---
SRC_DIR		= src
OBJ_DIR		= objects
INC_DIR		= includes
MLX_DIR		= mlx
LIB_DIR     = lib
LIBFT       = $(LIB_DIR)/libft.a

# --- FILES ---
# Add new .c files here as you create them
SRC_FILES	=	main.c \
				stdin_parse.c \
				parse_map.c \
				parse_file.c \
				path_way.c \
				lst_moves.c \
				parse_file_utils.c \
				validate_wall.c \
				path_way_utils.c \
				free_all.c \
				player.c \
				convert_grid.c \
				textures.c \
				key_handler.c \
				key_handler.c \
				parse.c

# These lines map the files to the correct folders
SRCS		= $(addprefix $(SRC_DIR)/, $(SRC_FILES))
OBJS		= $(addprefix $(OBJ_DIR)/, $(SRC_FILES:.c=.o))

# --- COMPILER & FLAGS ---
CC			= cc
CFLAGS		= -Wall -Wextra -Werror -g3 -I$(INC_DIR)
CPPFLAGS    = -I. -I$(LIB_DIR)
LDFLAGS     = -L$(LIB_DIR) -lft -lreadline

# MLX Flags for Linux/WSL
MLX_FLAGS	= -L$(MLX_DIR) -Lmlx -lmlx -framework OpenGL -framework AppKit

# --- RULES ---

all: $(NAME)

# Rule to compile the executable
$(NAME): $(OBJS) $(LIBFT)
	@echo "Compiling MiniLibX..."
	@make -C $(MLX_DIR) > /dev/null 2>&1
	@echo "Linking $(NAME)..."
	@$(CC) $(CFLAGS) $(OBJS) $(LDFLAGS) $(MLX_FLAGS) -o $(NAME)
	@echo "Done! ./$(NAME) is ready."

$(LIBFT):
	@echo "\033[1;34m[cube3d] Building Libft...\033[0m"
	@$(MAKE) -C $(LIB_DIR)

# Rule to compile objects (src/*.c -> objects/*.o)
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(OBJ_DIR)
	@$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

# Cleanup rules
clean:
	@echo "Cleaning object files..."
	@rm -rf $(OBJ_DIR)
	@make clean -C $(MLX_DIR) > /dev/null 2>&1

fclean: clean
	@echo "Removing executable..."
	@rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re
